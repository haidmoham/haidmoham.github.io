{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "c1n.mhaider.dev" }],
      "dest": "/c1n/index.html",
      "headers": {
        "Cache-Control": "no-cache",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
      }
    },
    {
      "src": "^/.*$",
      "continue": true,
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
      }
    },
    {
      "src": "^/c1n/?$",
      "missing": [{ "type": "host", "value": "c1n.mhaider.dev" }],
      "status": 308,
      "headers": { "Location": "https://c1n.mhaider.dev/" }
    },
    {
      "src": "^/$",
      "dest": "/index.html",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "src": "^/index\\.html$",
      "has": [{ "type": "host", "value": "c1n.mhaider.dev" }],
      "status": 308,
      "headers": {
        "Location": "https://mhaider.dev/"
      }
    },
    {
      "src": "^/about\\.html$",
      "has": [{ "type": "host", "value": "c1n.mhaider.dev" }],
      "status": 308,
      "headers": {
        "Location": "https://mhaider.dev/about.html"
      }
    },
    {
      "src": "^/available\\.html$",
      "has": [{ "type": "host", "value": "c1n.mhaider.dev" }],
      "status": 308,
      "headers": {
        "Location": "https://mhaider.dev/available.html"
      }
    },
    {
      "src": "^/projects\\.html$",
      "has": [{ "type": "host", "value": "c1n.mhaider.dev" }],
      "status": 308,
      "headers": {
        "Location": "https://mhaider.dev/projects.html"
      }
    },
    {
      "src": "^/robotics/?$",
      "has": [{ "type": "host", "value": "c1n.mhaider.dev" }],
      "status": 308,
      "headers": {
        "Location": "https://mhaider.dev/robotics/"
      }
    },
    {
      "src": "^/notes\\.html$",
      "has": [{ "type": "host", "value": "c1n.mhaider.dev" }],
      "status": 308,
      "headers": {
        "Location": "https://mhaider.dev/notes.html"
      }
    },
    {
      "src": "^/resume\\.html$",
      "has": [{ "type": "host", "value": "c1n.mhaider.dev" }],
      "status": 308,
      "headers": {
        "Location": "https://mhaider.dev/resume.html"
      }
    },
    {
      "src": "^/contact\\.html$",
      "has": [{ "type": "host", "value": "c1n.mhaider.dev" }],
      "status": 308,
      "headers": {
        "Location": "https://mhaider.dev/contact.html"
      }
    },
    {
      "src": "^/.*\\.wasm$",
      "continue": true,
      "headers": {
        "Content-Type": "application/wasm",
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
