<mujoco model="spider">
  <compiler angle="degree" autolimits="true" eulerseq="zyx"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <!-- C-1N's identity layer. Sites are render-only: they have no mass or contact. -->
  <asset>
    <material name="ceramic" rgba="0.68 0.71 0.69 1"/>
    <material name="upper_link" rgba="0.48 0.51 0.50 1"/>
    <material name="graphite" rgba="0.055 0.065 0.065 1"/>
    <material name="vermilion" rgba="0.90 0.16 0.07 1"/>
    <material name="eye_white" rgba="0.96 0.96 0.90 1"/>
    <material name="marking" rgba="0.92 0.88 0.72 1"/>
  </asset>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom contype="1" conaffinity="1" friction="1 0.5 0.5" density="500" rgba="0.01 0.01 0.015 1"/>
  </default>

  <worldbody>
    <light name="main" pos="0 0 2" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="12 12 0.1" rgba="0.91 0.925 0.945 1"/>

    <body name="torso" pos="0 0 0.38">
      <freejoint name="root"/>
      <geom name="torso_geom" type="box" size="0.22 0.16 0.07" material="ceramic" rgba="0.68 0.71 0.69 1"/>
      <site name="torso_center" pos="0 0 0" size="0.02" rgba="1 0 0 1"/>

      <!-- Googly Surveyor. Group 2 is the viewer-visible visual layer. -->
      <site name="cowl_visual" type="box" pos="0 0 0.078" size="0.17 0.125 0.009" material="graphite" rgba="0.055 0.065 0.065 1" group="2"/>
      <site name="left_eye_visual" type="sphere" pos="0.235 0.065 0.012" size="0.050" material="eye_white" rgba="0.96 0.96 0.90 1" group="2"/>
      <site name="right_eye_visual" type="sphere" pos="0.235 -0.065 0.012" size="0.050" material="eye_white" rgba="0.96 0.96 0.90 1" group="2"/>
      <site name="left_pupil_visual" type="sphere" pos="0.279 0.054 0.022" size="0.019" material="graphite" rgba="0.015 0.018 0.018 1" group="2"/>
      <site name="right_pupil_visual" type="sphere" pos="0.279 -0.076 -0.002" size="0.019" material="graphite" rgba="0.015 0.018 0.018 1" group="2"/>
      <site name="spine_visual" type="capsule" fromto="-0.16 0 0.091 -0.09 0 0.091" size="0.008" material="marking" rgba="0.92 0.88 0.72 1" group="2"/>

      <body name="front_left" pos="0.14 0.11 0" euler="38 55 0">
        <joint name="front_left_coxa" type="hinge" axis="0 0 1" range="-45 45"/>
        <joint name="front_left_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="front_left_thigh" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035" material="upper_link" rgba="0.48 0.51 0.50 1"/>
        <site name="front_left_joint_visual" type="sphere" size="0.052" material="graphite" rgba="0.055 0.065 0.065 1" group="2"/>
        <body name="front_left_shin" pos="0.26 0 0">
          <joint name="front_left_knee" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom name="front_left_shin_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.03" material="graphite" rgba="0.055 0.065 0.065 1"/>
          <geom name="front_left_foot" type="sphere" pos="0.24 0 0" size="0.045" material="vermilion" rgba="0.90 0.16 0.07 1"/>
          <site name="front_left_contact_site" pos="0.24 0 0" size="0.02"/>
        </body>
      </body>

      <body name="front_right" pos="0.14 -0.11 0" euler="-38 55 0">
        <joint name="front_right_coxa" type="hinge" axis="0 0 1" range="-45 45"/>
        <joint name="front_right_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="front_right_thigh" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035" material="upper_link" rgba="0.48 0.51 0.50 1"/>
        <site name="front_right_joint_visual" type="sphere" size="0.052" material="graphite" rgba="0.055 0.065 0.065 1" group="2"/>
        <body name="front_right_shin" pos="0.26 0 0">
          <joint name="front_right_knee" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom name="front_right_shin_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.03" material="graphite" rgba="0.055 0.065 0.065 1"/>
          <geom name="front_right_foot" type="sphere" pos="0.24 0 0" size="0.045" material="vermilion" rgba="0.90 0.16 0.07 1"/>
          <site name="front_right_contact_site" pos="0.24 0 0" size="0.02"/>
        </body>
      </body>

      <body name="middle_left" pos="0 0.16 0" euler="90 55 0">
        <joint name="middle_left_coxa" type="hinge" axis="0 0 1" range="-45 45"/>
        <joint name="middle_left_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="middle_left_thigh" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035" material="upper_link" rgba="0.48 0.51 0.50 1"/>
        <site name="middle_left_joint_visual" type="sphere" size="0.052" material="graphite" rgba="0.055 0.065 0.065 1" group="2"/>
        <body name="middle_left_shin" pos="0.26 0 0">
          <joint name="middle_left_knee" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom name="middle_left_shin_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.03" material="graphite" rgba="0.055 0.065 0.065 1"/>
          <geom name="middle_left_foot" type="sphere" pos="0.24 0 0" size="0.045" material="vermilion" rgba="0.90 0.16 0.07 1"/>
          <site name="middle_left_contact_site" pos="0.24 0 0" size="0.02"/>
        </body>
      </body>

      <body name="middle_right" pos="0 -0.16 0" euler="-90 55 0">
        <joint name="middle_right_coxa" type="hinge" axis="0 0 1" range="-45 45"/>
        <joint name="middle_right_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="middle_right_thigh" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035" material="upper_link" rgba="0.48 0.51 0.50 1"/>
        <site name="middle_right_joint_visual" type="sphere" size="0.052" material="graphite" rgba="0.055 0.065 0.065 1" group="2"/>
        <body name="middle_right_shin" pos="0.26 0 0">
          <joint name="middle_right_knee" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom name="middle_right_shin_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.03" material="graphite" rgba="0.055 0.065 0.065 1"/>
          <geom name="middle_right_foot" type="sphere" pos="0.24 0 0" size="0.045" material="vermilion" rgba="0.90 0.16 0.07 1"/>
          <site name="middle_right_contact_site" pos="0.24 0 0" size="0.02"/>
        </body>
      </body>

      <body name="rear_left" pos="-0.14 0.11 0" euler="142 55 0">
        <joint name="rear_left_coxa" type="hinge" axis="0 0 1" range="-45 45"/>
        <joint name="rear_left_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="rear_left_thigh" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035" material="upper_link" rgba="0.48 0.51 0.50 1"/>
        <site name="rear_left_joint_visual" type="sphere" size="0.052" material="graphite" rgba="0.055 0.065 0.065 1" group="2"/>
        <body name="rear_left_shin" pos="0.26 0 0">
          <joint name="rear_left_knee" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom name="rear_left_shin_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.03" material="graphite" rgba="0.055 0.065 0.065 1"/>
          <geom name="rear_left_foot" type="sphere" pos="0.24 0 0" size="0.045" material="vermilion" rgba="0.90 0.16 0.07 1"/>
          <site name="rear_left_contact_site" pos="0.24 0 0" size="0.02"/>
        </body>
      </body>

      <body name="rear_right" pos="-0.14 -0.11 0" euler="-142 55 0">
        <joint name="rear_right_coxa" type="hinge" axis="0 0 1" range="-45 45"/>
        <joint name="rear_right_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="rear_right_thigh" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035" material="upper_link" rgba="0.48 0.51 0.50 1"/>
        <site name="rear_right_joint_visual" type="sphere" size="0.052" material="graphite" rgba="0.055 0.065 0.065 1" group="2"/>
        <body name="rear_right_shin" pos="0.26 0 0">
          <joint name="rear_right_knee" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom name="rear_right_shin_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.03" material="graphite" rgba="0.055 0.065 0.065 1"/>
          <geom name="rear_right_foot" type="sphere" pos="0.24 0 0" size="0.045" material="vermilion" rgba="0.90 0.16 0.07 1"/>
          <site name="rear_right_contact_site" pos="0.24 0 0" size="0.02"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="front_left_coxa_motor" joint="front_left_coxa" kp="300" ctrlrange="-0.8 0.8"/>
    <position name="front_left_hip_motor" joint="front_left_hip" kp="300" ctrlrange="-0.8 0.8"/>
    <position name="front_left_knee_motor" joint="front_left_knee" kp="300" ctrlrange="-1.4 1.4"/>
    <position name="front_right_coxa_motor" joint="front_right_coxa" kp="300" ctrlrange="-0.8 0.8"/>
    <position name="front_right_hip_motor" joint="front_right_hip" kp="300" ctrlrange="-0.8 0.8"/>
    <position name="front_right_knee_motor" joint="front_right_knee" kp="300" ctrlrange="-1.4 1.4"/>
    <position name="middle_left_coxa_motor" joint="middle_left_coxa" kp="300" ctrlrange="-0.8 0.8"/>
    <position name="middle_left_hip_motor" joint="middle_left_hip" kp="300" ctrlrange="-0.8 0.8"/>
    <position name="middle_left_knee_motor" joint="middle_left_knee" kp="300" ctrlrange="-1.4 1.4"/>
    <position name="middle_right_coxa_motor" joint="middle_right_coxa" kp="300" ctrlrange="-0.8 0.8"/>
    <position name="middle_right_hip_motor" joint="middle_right_hip" kp="300" ctrlrange="-0.8 0.8"/>
    <position name="middle_right_knee_motor" joint="middle_right_knee" kp="300" ctrlrange="-1.4 1.4"/>
    <position name="rear_left_coxa_motor" joint="rear_left_coxa" kp="300" ctrlrange="-0.8 0.8"/>
    <position name="rear_left_hip_motor" joint="rear_left_hip" kp="300" ctrlrange="-0.8 0.8"/>
    <position name="rear_left_knee_motor" joint="rear_left_knee" kp="300" ctrlrange="-1.4 1.4"/>
    <position name="rear_right_coxa_motor" joint="rear_right_coxa" kp="300" ctrlrange="-0.8 0.8"/>
    <position name="rear_right_hip_motor" joint="rear_right_hip" kp="300" ctrlrange="-0.8 0.8"/>
    <position name="rear_right_knee_motor" joint="rear_right_knee" kp="300" ctrlrange="-1.4 1.4"/>
  </actuator>

  <sensor>
    <framequat name="torso_orientation" objtype="body" objname="torso"/>
    <framelinvel name="torso_velocity" objtype="body" objname="torso"/>
    <touch name="front_left_contact" site="front_left_contact_site"/>
    <touch name="front_right_contact" site="front_right_contact_site"/>
    <touch name="middle_left_contact" site="middle_left_contact_site"/>
    <touch name="middle_right_contact" site="middle_right_contact_site"/>
    <touch name="rear_left_contact" site="rear_left_contact_site"/>
    <touch name="rear_right_contact" site="rear_right_contact_site"/>
  </sensor>
</mujoco>
